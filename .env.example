# ==============================================================================
# CardioPath AI — Muhit o'zgaruvchilari shabloni (.env.example)
# Ishlatish: Ushbu fayldan nusxa olib, nomini `.env` deb o'zgartiring va sozlang.
# ==============================================================================

# Ish tartibi: 'research' (tadqiqot, ko'rsatkichlar ochiq) yoki 'product' (klinik foydalanish)
CARDIOPATH_MODE=research

# Avtorizatsiya: 'on' (foydalanuvchi/parol talab qilinadi) yoki 'off' (mahalliy ochiq)
CARDIOPATH_AUTH=off

# Baza fayli joylashuvi (SQLite)
CARDIOPATH_DB=cardiopath.db

# Model og'irliklari (onnx / joblib)
# CARDIOPATH_WEIGHTS=weights/pcg
# CARDIOPATH_AKI_WEIGHTS=weights/aki/model.joblib
# CARDIOPATH_ECG_WEIGHTS=weights/ecg/model.onnx
# CARDIOPATH_ANGIO_WEIGHTS=weights/angio/model.onnx
# CARDIOPATH_EF_WEIGHTS=weights/echo_ef/heart_echonet.onnx

# Shadow rejim (yangi nomzod modellar solishtiruv uchun, vergul bilan ajratilgan)
# CARDIOPATH_SHADOW=

# Rozilik berilgan PCG audio yozuvlar saqlanadigan papka
CARDIOPATH_RECORDINGS=data/recordings

# Yangi model versiyalari katalogi
CARDIOPATH_MODELS=models

# Avtomatik o'z-o'zini o'qitish davri (soatlarda, 0 — o'chiq)
CARDIOPATH_LEARNING_EVERY_H=0
# CARDIOPATH_CIRCOR_DIR=data/circor

# Avtomatik zaxira nusxalash (Backups)
CARDIOPATH_BACKUP_DIR=backups
CARDIOPATH_BACKUP_EVERY_H=24
CARDIOPATH_BACKUP_KEEP=14

# Guardian tezkor eskalatsiyasi (Telegram xabarnomasi — ixtiyoriy)
# CARDIOPATH_TG_TOKEN=
# CARDIOPATH_TG_CHAT=
